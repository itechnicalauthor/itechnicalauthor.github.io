<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="Microsoft.PowerBI.DataMovement.Pipeline.GatewayCore.GatewayCoreSettings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
      <section name="Microsoft.PowerBI.DataMovement.Pipeline.GatewayCore.GatewayCore" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <system.serviceModel>
    <services>
      <service name="GatewayTransferService" behaviorConfiguration="GatewayTransferServiceBehavior" />
    </services>
    <extensions>
      <bindingExtensions>
        <add name="GatewayNetTcpRelayBinding" type="Microsoft.ServiceBus.Configuration.NetTcpRelayBindingCollectionElement, Microsoft.ServiceBus, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"/>
      </bindingExtensions>
    </extensions>
    <bindings>
      <!-- The packet size is 8 MB and in the worst case, the compressed packet can be slightly larger than that; so using 8.5 MB -->
      <GatewayNetTcpRelayBinding>
        <binding name="GatewayServiceBusTransferBinding" connectionMode="Relayed" transferMode="Buffered" receiveTimeout="06:00:00" maxReceivedMessageSize="8500000" maxBufferSize="8500000" maxBufferPoolSize="8500000" maxConnections="1500" isDynamic="false">
          <reliableSession ordered="true" inactivityTimeout="00:10:00" enabled="false" />
        </binding>
      </GatewayNetTcpRelayBinding>
    </bindings>
    <behaviors>
      <serviceBehaviors>
        <behavior name="GatewayTransferServiceBehavior">
          <serviceThrottling maxConcurrentCalls="150000" maxConcurrentSessions="1500"/>
        </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>
  <applicationSettings>
    <!--
      Microsoft.PowerBI.DataMovement.Pipeline.GatewayClient.GatewayClientSettings

      * DbConnectionPoolMinSize: minimum size of the DB connection pool.
      * DbConnectionPoolMaxSize: maximum size of the DB connection pool.
      * DbConnectionPoolExpirationTimeout2: maximum time a connection can stay in the pool without being used.
      * DbConnectionStatefulPoolMaxSize: maximum size of the DB stateful connection pool.
      * DbConnectionStatefulPoolExpirationTimeout: maximum time a connection can stay in the stateful pool without being used.
      * ServiceBusSystemConnectivityModeString: the ServiceBus connectivity mode to use. Valid values are AutoDetect, Https.
      
      Domain settings: 
      * ADUserNameReplacementProperty: Case-sensitive. Ensure same as property name in AD
      * ADServerPath: 
          - Supports multiple servers as collection separated by semicolon searched left to right (e.g. GC://serverpath1; GC://serverpath2;GC://serverpath3). 
          - If not specified, gateway will use the default GC for AD Lookup. 
          - If no match found, then the original UPN will be used.
          - Supports two types of AD server path
              - WinNT://corp.<domain>.com,computer
              - GC://USA.<domain>.com
          - Ensure account running gateway service (default: PBIEgwService) has query permission to all AD servers you specified in ADServerPath.
      * ADUserNameLookupProperty: Case-sensitive. Ensure same as property name in AD
      * FullDomainResolutionEnabled:
      * SapHanaSsoRemoveDomainEnabled:
      
      SAML settings:
      * SapHanaSAMLCertThumbprint: The thumbprint for the identity provider's certificate.
      * SAMLAssertionLifeTimeInMinutes: Lifetime of SAML assertion token in minutes
      * SAMLAssertionTimeDriftToleranceInMinutes: Allows for time skew between Gateway host server and SAP server
      
      Diagnostic settings - see "Diagnostics" tab in Gateway application, do not edit manually
      * DisablePerfCounterTelemetry
      * EtwExtendedTracing
      * SapTraceLevel
      * MashupLogMaximumNumberOfFiles
     
      Internal settings - do not change
      * SpoolerOperationMaxOutstandingStreamedPackets
      * SpoolerDirectory
      * StreamBeforeRequestCompletes
      * EmitQueryTraces
      * MashupDSRTestConnectionTimeout, 2 minute maximum
      * MashupCustomConnectorsDirectory
      * MashupCustomConnectors
      * MashupDisableContainerAutoConfig
      * MashupKindSkipTest
      * MashupKindSkipEncryptionTest

      Internal settings - Mashup container settings
      * MashupDisableContainerAutoConfig: 'True' to override computed values with values specified in this file
      * MashupDefaultPoolContainerMaxCount: Max container count for Default ('Refresh') pool
        - Default count calculation roughly scales with processor count:
            CPUCount  ContainerCount
            2         6
            4         8
            8         16
            16        24
            32        40
            64        72
      * MashupDQPoolContainerMaxCount: Max container count for Power BI Direct Query pool
      * MashupTestConnectionPoolContainerMaxInstanceCount: Max container count for test connection pool
      * MashupAzureConnectorsCachingPoolContainerMaxCount: Max container count for Azure Connectors (LogicApps, PowerApps, Flow) pool
      * PowerQueryOnlineCachingPoolContainerMaxCount: Max container count for Power Query Online Authoring evaluations

      (Note: keep the comment outside of the element so it does not get overwritten when the config section is auto-generated.)
    -->
    <Microsoft.PowerBI.DataMovement.Pipeline.GatewayCore.GatewayCoreSettings>
      <setting name="DbConnectionPoolMinSize" serializeAs="String">
        <value>128</value>
      </setting>
      <setting name="DbConnectionPoolMaxSize" serializeAs="String">
        <value>256</value>
      </setting>
      <setting name="DbConnectionPoolExpirationTimeout2" serializeAs="String">
        <value>00:10:00</value>
      </setting>
      <setting name="DbConnectionStatefulPoolMaxSize" serializeAs="String">
        <value>256</value>
      </setting>
      <setting name="DbConnectionStatefulPoolExpirationTimeout" serializeAs="String">
        <value>00:10:00</value>
      </setting>
      <setting name="SpoolerOperationMaxOutstandingStreamedPackets"
        serializeAs="String">
        <value>4</value>
      </setting>
      <setting name="ServiceBusSystemConnectivityModeString" serializeAs="String">
        <value>Https</value>
      </setting>
      <setting name="EmitQueryTraces" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="SpoolerDirectory" serializeAs="String">
        <value>%LOCALAPPDATA%\Microsoft\On-premises data gateway\Spooler</value>
      </setting>
      <setting name="StreamBeforeRequestCompletes" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="ADUserNameReplacementProperty" serializeAs="String">
        <value />
      </setting>
      <setting name="ADServerPath" serializeAs="String">
        <value />
      </setting>
      <setting name="ADUserNameLookupProperty" serializeAs="String">
        <value />
      </setting>
      <setting name="MashupDQPoolContainerMaxCount" serializeAs="String">
        <value>20</value>
      </setting>
      <setting name="FullDomainResolutionEnabled" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="MashupDSRTestConnectionTimeout" serializeAs="String">
        <value>00:00:50</value>
      </setting>
      <setting name="DisablePerfCounterTelemetry" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="MashupTestConnectionPoolContainerMaxInstanceCount"
        serializeAs="String">
        <value>24</value>
      </setting>
      <setting name="MashupDefaultPoolContainerMaxCount" serializeAs="String">
        <value>1</value>
      </setting>
      <setting name="MashupAzureConnectorsCachingPoolContainerMaxCount"
        serializeAs="String">
        <value>20</value>
      </setting>
      <setting name="PowerQueryOnlineCachingPoolContainerMaxCount"
        serializeAs="String">
        <value>20</value>
      </setting>
      <setting name="EtwExtendedTracing" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="MashupCustomConnectorsDirectory" serializeAs="String">
        <value>%UserProfile%\Documents\Power BI Desktop\Custom Connectors</value>
      </setting>
      <setting name="SapHanaSsoRemoveDomainEnabled" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="MashupCustomConnectors" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="SapTraceLevel" serializeAs="String">
        <value>Warning</value>
      </setting>
      <setting name="SapHanaSAMLCertThumbprint" serializeAs="String">
        <value />
      </setting>
      <setting name="SAMLAssertionLifeTimeInMinutes" serializeAs="String">
        <value>60</value>
      </setting>
      <setting name="SAMLAssertionTimeDriftToleranceInMinutes" serializeAs="String">
        <value>5</value>
      </setting>
      <setting name="MashupDisableContainerAutoConfig" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="MashupKindSkipTest" serializeAs="String">
        <value />
      </setting>
      <setting name="MashupLogMaximumNumberOfFiles" serializeAs="String">
        <value>20</value>
      </setting>
      <setting name="MashupKindSkipEncryptionTest" serializeAs="String">
        <value />
      </setting>
      <setting name="ReportFilePath" serializeAs="String">
        <value>%LOCALAPPDATA%\Microsoft\On-premises data gateway\Report</value>
      </setting>
      <setting name="ReportFileCount" serializeAs="String">
        <value>10</value>
      </setting>
      <setting name="ReportFileSizeInBytes" serializeAs="String">
        <value>104857600</value>
      </setting>
      <setting name="QueryExecutionAggregationTimeInMinutes" serializeAs="String">
        <value>5</value>
      </setting>
      <setting name="SystemCounterAggregationTimeInMinutes" serializeAs="String">
        <value>5</value>
      </setting>
      <setting name="EnableFastCombine" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="ADDisableImpersonationLevelErrors" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="PacketTraceConfig" serializeAs="String">
        <value />
      </setting>
      <setting name="CPUUtilizationPercentageThreshold" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="MemoryUtilizationPercentageThreshold" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="ResourceUtilizationAggregationTimeInMinutes" serializeAs="String">
        <value>5</value>
      </setting>
      <setting name="MashupDefaultPoolContainerMaxWorkingSetInMB" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="SapErpLogMaximumNumberOfFiles" serializeAs="String">
        <value>20</value>
      </setting>
    </Microsoft.PowerBI.DataMovement.Pipeline.GatewayCore.GatewayCoreSettings>
  </applicationSettings>
</configuration>
